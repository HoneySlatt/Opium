[Desktop Entry]
Type=Application
Name=Music
GenericName=Music Player
Comment=Apple Music, SoundCloud, Navidrome and your own music files in one player
Exec=music %U
Icon=music
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=apple music;soundcloud;navidrome;subsonic;lyrics;flac;mp3;
MimeType=audio/flac;audio/x-flac;audio/mpeg;audio/mp3;audio/wav;audio/x-wav;audio/aiff;audio/x-aiff;audio/mp4;audio/x-m4a;audio/aac;audio/ogg;audio/vorbis;audio/x-vorbis+ogg;
StartupWMClass=music
